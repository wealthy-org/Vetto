# Salin file ini ke apps/web/.env.local (Next.js hanya membaca env dari folder app, bukan root repo).
APP_ORIGIN=http://localhost:3000   # production: URL publik, mis. https://vetto.app

# Public (shipped to the browser). Never put secrets here.
NEXT_PUBLIC_CHAIN_ID=4663
# Set to enable sign-in UI (e.g. "privy" | "wagmi"). Unset = "not configured".
NEXT_PUBLIC_AUTH_PROVIDER=

# Server only
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # NeonDB (PostgreSQL only, no Redis)
ROBINHOOD_RPC_URL=                                           # verify via official sources first (Phase 0)
LLM_API_KEY=                                                 # parser only; never gets signing authority
RATE_LIMIT_SALT=change-me
# Production requires a generated value with at least 32 characters; the placeholder fails closed.
