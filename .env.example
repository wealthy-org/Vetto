# Salin file ini ke apps/web/.env.local (Next.js hanya membaca env dari folder app, bukan root repo).
APP_ORIGIN=http://localhost:3000   # production: URL publik, mis. https://vetto.app

# Public (shipped to the browser). Never put secrets here.
NEXT_PUBLIC_CHAIN_ID=4663
# Public WalletConnect Cloud project ID. Unset keeps wallet sign-in disabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server only
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # NeonDB (PostgreSQL only, no Redis)
ROBINHOOD_RPC_URL_PRIMARY=                                   # HTTPS, from an official source
ROBINHOOD_RPC_URL_SECONDARY=                                 # independent HTTPS RPC; Alchemy Robinhood Mainnet endpoint is documented in README
ROBINHOOD_USDG_ADDRESS=                                      # verify address from official sources before use
ROBINHOOD_POOL_FEE=                                          # v4 Initialize event fee for the exact ETH/USDG pool
ROBINHOOD_POOL_TICK_SPACING=                                 # v4 Initialize event tick spacing for the exact pool
ROBINHOOD_POOL_HOOKS_ADDRESS=                                # v4 Initialize event hooks address; zero address if no hook
ROBINHOOD_POOL_SCAN_FROM_BLOCK=                              # trusted PoolManager deployment/start block; max range 250000
ROBINHOOD_POOL_SCAN_TO_BLOCK=                                # optional scan end block; defaults to the common RPC head
ROBINHOOD_POOL_SCAN_CHUNK_SIZE=                              # number of blocks to scan in each chunk
ROBINHOOD_POOL_SCAN_CHUNK_DELAY_MS=                          # delay between chunk scans in milliseconds
LLM_API_KEY=                                                 # optional; prompts go to this provider for parsing only, never signing
LLM_API_URL=https://api.openai.com/v1/chat/completions      # OpenAI-compatible endpoint; HTTPS required except localhost
LLM_MODEL=gpt-4o-mini
RATE_LIMIT_SALT=change-me
# Production requires a generated value with at least 32 characters; the placeholder fails closed.
# Jumlah proxy tepercaya di depan app (Vercel/Cloudflare = 1). WAJIB di production; tanpa ini semua klien berbagi satu rate-limit bucket.
TRUST_PROXY_HOPS=

$env:ROBINHOOD_RPC_URL_PRIMARY = "https://robinhood-mainnet.g.alchemy.com/v2/alch_FaMUCmwTXXkA3IIIDEwkk"
$env:ROBINHOOD_RPC_URL_SECONDARY = "https://robinhood.drpc.org"
$env:ROBINHOOD_USDG_ADDRESS = "0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168"
pnpm verify:chain

$env:ROBINHOOD_POOL_SCAN_FROM_BLOCK = "103739691"
$env:ROBINHOOD_POOL_SCAN_TO_BLOCK = "103774725"
$env:ROBINHOOD_POOL_SCAN_CHUNK_SIZE = "10"
pnpm discover:pools


$env:ROBINHOOD_POOL_FEE = "500"
$env:ROBINHOOD_POOL_TICK_SPACING = "10"
$env:ROBINHOOD_POOL_HOOKS_ADDRESS = "0x0000000000000000000000000000000000000000"
$env:ROBINHOOD_POOL_SCAN_CHUNK_DELAY_MS = "1500"
pnpm verify:pool