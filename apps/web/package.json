{
  "name": "@vetto/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./test/register.mjs --experimental-strip-types --no-warnings --test lib/*.test.ts test/*.test.ts scripts/*.test.mjs",
    "verify:chain": "node scripts/verify-chain.mjs",
    "verify:pool": "node scripts/verify-pool.mjs",
    "discover:pools": "node scripts/discover-pools.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@vetto/asset-registry": "workspace:*",
    "@vetto/intent-parser": "workspace:*",
    "@vetto/quote-engine": "workspace:*",
    "@vetto/safety-policy": "workspace:*",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "gsap": "^3.12.7",
    "next": "^15.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3"
  }
}
