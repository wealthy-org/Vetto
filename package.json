{
  "name": "vetto",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @vetto/web dev",
    "build": "pnpm --filter @vetto/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:chain": "pnpm --filter @vetto/web verify:chain",
    "verify:pool": "pnpm --filter @vetto/web verify:pool",
    "db:migrate": "pnpm --filter @vetto/web db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.7.3"
  }
}
